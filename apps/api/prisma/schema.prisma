generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  ja
}

enum WorldMode {
  single
  multi
}

// multi は P1。MVP は single のみ生成
enum PostKind {
  user
  character
  news
  ambient
  system
}

enum ThreadPartyKind {
  persona
  character
}

enum LedgerSource {
  daily_refill
  ad_reward
  referral
  purchase
  plus_daily
  spend
  admin
}

enum Currency {
  energy
  coffee
  gems
}

enum SubPlan {
  plus_weekly
  plus_monthly
  plus_yearly
  adfree_monthly
}

enum SafetyVerdict {
  allow
  soften
  block
}

enum GeneratorId {
  G1
  G2
  G3
  G4
  G5
  G7
  G8
  G9
  G10
  GJ
}

/// teardown: User
model User {
  id               String                 @id @default(cuid())
  email            String?                @unique
  authProvider     String // apple | google | email
  authSubject      String
  birthYear        Int // 年齢ゲート(13+)。18歳未満は minor=true
  isMinor          Boolean                @default(true)
  locale           Locale                 @default(en)
  createdAt        DateTime               @default(now())
  /// S1-1 アカウント削除: 論理削除 → 30日後に purge ジョブが物理削除
  deletedAt        DateTime?
  /// S1-6 データ収集の同意(未成年は既定 false、行動ターゲティング広告を止める)
  analyticsConsent Boolean                @default(false)
  /// S2-5 リファラル: 自分の招待コード
  referralCode     String?                @unique
  /// 連続ログイン。台帳からの導出をやめ、正本をここに置く(build-notes: streak storage)
  streakDays       Int                    @default(0)
  streakBestDays   Int                    @default(0)
  streakLastAt     DateTime?
  personas         Persona[]
  wallet           Wallet?
  subscription     Subscription?
  purchases        Purchase[]
  assignments      ExperimentAssignment[]
  ratings          Rating[]
  reports          Report[]
  pushTokens       PushToken[]
  referralsSent    Referral[]             @relation("inviter")
  referralUsed     Referral?              @relation("invitee")

  @@unique([authProvider, authSubject])
  @@index([deletedAt])
}

/// teardown: Persona(ユーザーが演じるアカウント)
model Persona {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  worldId            String
  world              World               @relation(fields: [worldId], references: [id])
  handle             String // @taytay19
  displayName        String
  bio                String              @default("")
  avatarUrl          String?
  voiceNotes         String              @default("") // 口調メモ(AIF-004 で自動抽出、MVP は手入力)
  followers          Int                 @default(120)
  aura               Int                 @default(20) // 0..100
  humor              Int                 @default(20) // 0..100
  level              Int                 @default(1)
  xp                 Int                 @default(0)
  actionCount        Int                 @default(0) // イベント発火判定に使用
  worldSummary       String              @default("") // G7 が更新する世界要約 ≤400 tok
  createdAt          DateTime            @default(now())
  posts              Post[]
  threads            DMThread[]
  relationships      RelationshipState[]
  stats              StatSnapshot[]
  events             Event[]
  blocks             BlockedCharacter[]
  digests            Digest[]
  moments            Moment[]
  notifications      Notification[]
  achievementUnlocks AchievementUnlock[]

  @@unique([worldId, handle])
}

/// teardown: World
model World {
  id          String           @id @default(cuid())
  slug        String           @unique // popstar-era, magic-academy, idol-survival
  title       Json // {en, ja}
  scenario    Json // {en, ja} 1行シナリオ
  bible       Json // {en: string, ja: string} G9 出力そのまま(=キャッシュ用 system[1])
  bibleTokens Int // count_tokens で計測(>=4096 を CI で assert)
  mode        WorldMode        @default(single)
  isPreset    Boolean          @default(true)
  difficulty  Int              @default(2) // ★の数
  coverUrl    String?
  createdBy   String?
  createdAt   DateTime         @default(now())
  characters  WorldCharacter[]
  personas    Persona[]
  ambientPool AmbientPost[]
}

/// teardown: CharacterTemplate + WorldCharacter を MVP では1つに統合(プリセットのみ)
model WorldCharacter {
  id                 String              @id @default(cuid())
  worldId            String
  world              World               @relation(fields: [worldId], references: [id])
  handle             String
  displayName        String
  role               String // rival | bestie | press | producer ...
  card               Json // {en, ja}: 口調/価値観/口癖/NG(bible 内の該当部分と同一文字列)
  avatarUrl          String?
  isPressAccount     Boolean             @default(false) // @gmz 型
  canBeFirstFollower Boolean             @default(true)
  posts              Post[]
  threads            DMThread[]
  relationships      RelationshipState[]
  blockedBy          BlockedCharacter[]
  notifications      Notification[]

  @@unique([worldId, handle])
}

/// teardown: Post(user|character|news|ambient)
model Post {
  id                String          @id @default(cuid())
  worldId           String
  personaId         String? // 閲覧主(フィードのオーナー)。ambient は null
  persona           Persona?        @relation(fields: [personaId], references: [id])
  authorPersonaId   String?
  authorCharacterId String?
  authorCharacter   WorldCharacter? @relation(fields: [authorCharacterId], references: [id])
  kind              PostKind
  text              String
  parentId          String?
  parent            Post?           @relation("replies", fields: [parentId], references: [id])
  replies           Post[]          @relation("replies")
  metrics           Json            @default("{}") // {likes, reposts, replies} 演出値(サーバ計算)
  /// 手続き的に描くメディア。null=テキストのみ。"art"|"chart"|"leak" とシード(決定的に同じ絵になる)
  mediaKind         String?
  mediaSeed         String?
  /// バズ判定。トレンド表示とモーメント生成の入力
  heat              Int             @default(0)
  generationId      String?
  generation        GenerationLog?  @relation(fields: [generationId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([personaId, createdAt])
  @@index([parentId])
  @@index([worldId, kind])
  @@index([personaId, heat])
  @@index([authorCharacterId])
}

/// 公開ワールド共有の雑談プール(G2, Batch 生成)
model AmbientPost {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id])
  characterId String
  locale      Locale
  text        String
  createdAt   DateTime @default(now())

  @@index([worldId, locale])
  @@index([worldId, locale, createdAt])
}

/// teardown: DMThread / DMMessage
model DMThread {
  id            String         @id @default(cuid())
  personaId     String
  persona       Persona        @relation(fields: [personaId], references: [id])
  characterId   String
  character     WorldCharacter @relation(fields: [characterId], references: [id])
  lastMessageAt DateTime       @default(now())
  unreadCount   Int            @default(0)
  messages      DMMessage[]

  @@unique([personaId, characterId])
}

model DMMessage {
  id            String   @id @default(cuid())
  threadId      String
  thread        DMThread @relation(fields: [threadId], references: [id])
  fromCharacter Boolean
  text          String
  generationId  String?
  createdAt     DateTime @default(now())

  @@index([threadId, createdAt])
}

/// teardown: Event(ドラマカード)+ EventChoice(JSON 埋め込み)
model Event {
  id           String    @id @default(cuid())
  personaId    String
  persona      Persona   @relation(fields: [personaId], references: [id])
  title        String
  prompt       String // 「匿名ソースが…どう応じる?」
  choices      Json // [{id, label, outcomeText, statDeltas:{followers,aura,humor}, relationshipDeltas:{characterId:int}}] ×3
  chosenId     String?
  resolvedAt   DateTime?
  generationId String?
  createdAt    DateTime  @default(now())

  @@index([personaId, resolvedAt])
  @@index([personaId, createdAt])
}

/// teardown: StatSnapshot(アクション毎の差分)
model StatSnapshot {
  id             String   @id @default(cuid())
  personaId      String
  persona        Persona  @relation(fields: [personaId], references: [id])
  cause          String // post:<id> | event:<id> | dm:<id>
  narrative      String // 1〜2文(G1/G5 出力)
  followersDelta Int
  auraDelta      Int
  humorDelta     Int
  relDeltas      Json // {characterId: +1|-1}
  createdAt      DateTime @default(now())
}

/// teardown: RelationshipState + MemoryEntry
model RelationshipState {
  id          String         @id @default(cuid())
  personaId   String
  persona     Persona        @relation(fields: [personaId], references: [id])
  characterId String
  character   WorldCharacter @relation(fields: [characterId], references: [id])
  affinity    Int            @default(0) // -100..100
  summary     String         @default("") // ≤150 tok(G7)
  isFollower  Boolean        @default(false)
  memories    MemoryEntry[]

  @@unique([personaId, characterId])
}

model MemoryEntry {
  id             String            @id @default(cuid())
  relationshipId String
  relationship   RelationshipState @relation(fields: [relationshipId], references: [id])
  note           String // G1 の memory_notes 1件
  sourceRef      String // post:<id>
  consolidated   Boolean           @default(false)
  createdAt      DateTime          @default(now())
}

/// teardown: Wallet / LedgerEntry(エネルギー・Coffee・Gems)
model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  energy         Int           @default(10)
  coffee         Int           @default(0)
  gems           Int           @default(0)
  dailyRefillAt  DateTime      @default(now())
  adRewardsToday Int           @default(0)
  entries        LedgerEntry[]
}

model LedgerEntry {
  id        String       @id @default(cuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id])
  currency  Currency
  delta     Int
  source    LedgerSource
  ref       String?
  createdAt DateTime     @default(now())

  @@index([walletId, createdAt])
}

/// teardown: Purchase / Subscription(RevenueCat webhook で更新)
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sku       String
  store     String // app_store | play | stripe
  amountUsd Decimal  @db.Decimal(8, 2)
  rcEventId String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  plan           SubPlan
  active         Boolean
  renewsAt       DateTime?
  rcSubscriberId String
}

/// LLM 呼び出しの全ログ(cost-architecture §6.1)
model GenerationLog {
  id               String         @id @default(cuid())
  userId           String?
  generator        GeneratorId
  variantId        String
  model            String
  promptHash       String
  inputTokens      Int
  cacheWriteTokens Int
  cacheReadTokens  Int
  outputTokens     Int
  costUsd          Decimal        @db.Decimal(10, 6)
  ttftMs           Int?
  latencyMs        Int
  stopReason       String
  safetyVerdict    SafetyVerdict?
  escalatedFrom    String? // 再生成時の元 log id
  createdAt        DateTime       @default(now())
  posts            Post[]
  ratings          Rating[]

  @@index([generator, variantId, createdAt])
  @@index([userId, createdAt])
  /// S3-5 コスト集計(日次ロールアップ)
  @@index([createdAt])
}

model ExperimentAssignment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  experimentKey String
  variantId     String
  createdAt     DateTime @default(now())

  @@unique([userId, experimentKey])
}

model Rating {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  generationId String
  generation   GenerationLog @relation(fields: [generationId], references: [id])
  value        Int // -1 | +1
  regenerate   Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

// ─────────────────────────────────────────────────────────────
// S1 — 法令・ストア審査対応
// ─────────────────────────────────────────────────────────────

enum ReportTarget {
  post
  dm_message
  character
  world
}

enum ReportStatus {
  open
  triaged
  actioned
  dismissed
}

/// S1-2 通報(App Store Guideline 1.2: UGC/AI生成物に必須)
model Report {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  target       ReportTarget
  targetId     String
  /// 生成物の場合、原因となった生成を辿れるようにする
  generationId String?
  reason       String // harassment | sexual | self_harm | hate | off_character | other
  note         String       @default("")
  /// 通報時点の本文スナップショット(元が消えても審査できる)
  snapshot     String       @default("")
  status       ReportStatus @default(open)
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([target, targetId])
}

/// S1-2 ブロック(通報とセットで審査要件)。ブロックしたキャラはフィード・DMから消える
model BlockedCharacter {
  id          String         @id @default(cuid())
  personaId   String
  persona     Persona        @relation(fields: [personaId], references: [id], onDelete: Cascade)
  characterId String
  character   WorldCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([personaId, characterId])
  @@index([personaId])
}

// ─────────────────────────────────────────────────────────────
// S2 — リテンション / グロース
// ─────────────────────────────────────────────────────────────

enum PushPlatform {
  ios
  android
  web
}

/// S2-2 プッシュ通知の宛先(Expo push token)
model PushToken {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform
  enabled    Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  @@index([userId, enabled])
}

/// S2-1 Offline World Director: 不在中に進んだ世界のダイジェスト
model Digest {
  id           String    @id @default(cuid())
  personaId    String
  persona      Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  /// 見出し1行 + 本文(生成物)
  headline     String
  body         String
  /// このダイジェストで生成された投稿/DMの id(クライアントが強調表示に使う)
  postIds      Json      @default("[]")
  generationId String?
  seenAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([personaId, seenAt])
  @@index([personaId, createdAt])
}

/// S2-4 Shareable Moment: バズ/炎上の瞬間を縦型カード化したもの
model Moment {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  /// 何が起きたか(投稿/イベント)
  cause     String
  headline  String
  body      String
  /// カード描画に必要な値(スタッツ差分・キャラ反応)をそのまま持つ
  payload   Json
  shareSlug String   @unique
  createdAt DateTime @default(now())

  @@index([personaId, createdAt])
}

/// S2-5 リファラル: 招待した/されたの記録と報酬
model Referral {
  id         String    @id @default(cuid())
  inviterId  String
  inviter    User      @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId  String    @unique
  invitee    User      @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  code       String
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([inviterId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Engagement — the surfaces that make people come back
// ─────────────────────────────────────────────────────────────

enum NotificationKind {
  like
  reply
  follow
  mention
  dm
  milestone
  event
  digest
  unlock
}

/// 通知タブ。SNS 系プロダクト最大のドーパミン装置で、MVP には存在しなかった。
model Notification {
  id        String           @id @default(cuid())
  personaId String
  persona   Persona          @relation(fields: [personaId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// 誰がやったか(キャラ)。milestone / unlock は null
  actorId   String?
  actor     WorldCharacter?  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  /// 遷移先。post:<id> | dm:<threadId> | event:<id> | profile | achievement:<key>
  target    String?
  /// 表示行。ロケール済みの完成した文字列を保存する(一覧の描画にクエリを増やさないため)
  text      String
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([personaId, readAt])
  @@index([personaId, createdAt])
}

/// 実績の解除記録。カタログ自体は packages/shared の ACHIEVEMENTS(コード側)が持つ。
model AchievementUnlock {
  id         String    @id @default(cuid())
  personaId  String
  persona    Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  key        String
  /// 解除時点の値(「フォロワー 1,000 人」の 1,000 など)。カードに出す
  value      Int       @default(0)
  seenAt     DateTime?
  unlockedAt DateTime  @default(now())

  @@unique([personaId, key])
  @@index([personaId, unlockedAt])
}

// ─────────────────────────────────────────────────────────────
// 認証コードの永続化 / コスト最適化(バンディットとオフライン評価)
// ─────────────────────────────────────────────────────────────

/// S0-1 のワンタイムコード。MVP ではプロセス内 Map だったため単一インスタンスでしか動かなかった。
/// 平文は保存しない(ソルト + sha256)。期限切れは purge ジョブが掃除する。
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  salt       String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// cost-architecture §6.3 の腕。Thompson sampling の事後分布をここに永続化する。
/// 報酬は quality - λ×cost を 0..1 に正規化したもので、alpha/beta はその Beta 事後。
model BanditArm {
  id             String    @id @default(cuid())
  generator      String
  variantId      String
  alpha          Float     @default(1)
  beta           Float     @default(1)
  calls          Int       @default(0)
  rewardSum      Float     @default(0)
  costSum        Float     @default(0)
  /// 明示的に champion に固定された腕。昇格で移動する
  isChampion     Boolean   @default(false)
  /// 探索の下限割当(0..1)。0 で実質停止
  floor          Float     @default(0.05)
  /// guardrail 違反で自動的に止められた腕
  disabledAt     DateTime?
  disabledReason String?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([generator, variantId])
  @@index([generator, isChampion])
}

/// 昇格・ロールバックの監査ログ。いつ何を根拠に champion を動かしたか。
model PromotionEvent {
  id          String   @id @default(cuid())
  generator   String
  fromVariant String?
  toVariant   String
  reason      String
  metrics     Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([generator, createdAt])
}

enum EvalStatus {
  running
  finished
  failed
}

/// cost-architecture §6.2 の凍結評価セット。1 ケース = 1 生成器への 1 入力。
model EvalCase {
  id        String       @id @default(cuid())
  generator String
  locale    String
  worldSlug String
  /// 生成器の入力そのもの(zod で検証済みの JSON)
  input     Json
  /// 手で足した難問は frozen=true で必ず含める
  frozen    Boolean      @default(true)
  label     String       @default("")
  createdAt DateTime     @default(now())
  results   EvalResult[]

  @@index([generator, locale])
}

model EvalRun {
  id         String       @id @default(cuid())
  generator  String
  variantId  String
  status     EvalStatus   @default(running)
  cases      Int          @default(0)
  passed     Int          @default(0)
  meanScore  Float        @default(0)
  costUsd    Decimal      @default(0) @db.Decimal(10, 6)
  notes      String       @default("")
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  results    EvalResult[]

  @@index([generator, startedAt])
}

model EvalResult {
  id        String   @id @default(cuid())
  runId     String
  run       EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId    String
  evalCase  EvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// 機械判定(JSON 妥当性・K 充足・禁止語)と審査員スコアの内訳
  scores    Json     @default("{}")
  score     Float    @default(0)
  passed    Boolean  @default(false)
  costUsd   Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([runId, caseId])
  @@index([runId])
}
