# Local / test defaults. Loaded by apps/api ONLY when NODE_ENV != production (S0-3).
# Production must supply every value below as real environment variables — see docs/deploy.md.
NODE_ENV=development
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rpgllm
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/rpgllm_test

# Sessions. Production requires >= 32 chars and must NOT be this value (assertProductionConfig).
JWT_SECRET=dev-secret-change-me
PORT=4000

# Accept the constant dev login code (000000) at POST /auth/email/verify.
# Local + E2E only; TEST_HOOKS=1 implies it. Refused at boot when NODE_ENV/APP_ENV=production.
AUTH_DEV_CODE=1
AUTH_CODE_TTL_MS=600000
AUTH_CODE_MAX_ATTEMPTS=5

LLM_MODE=replay            # replay | live | fail
ANTHROPIC_API_KEY=
LLM_MODEL_HIGH=claude-opus-5
LLM_MODEL_MID=claude-sonnet-5
LLM_MODEL_LIGHT=claude-haiku-4-5

TEST_HOOKS=0
BILLING_MODE=test          # test | revenuecat  (test is refused in production)
ADS_MODE=test              # test | admob      (test is refused in production)

# ---- RevenueCat (Agent P). See docs/billing.md for how to obtain each of these. ----
# Shared secret typed into the RevenueCat dashboard's webhook Authorization header. REQUIRED in
# production: without it POST /v1/billing/webhook refuses every request that is not signed, and
# with BILLING_MODE != test it refuses unsigned requests outright.
REVENUECAT_WEBHOOK_SECRET=
# REST API v1 secret key (sk_...). Used only by POST /v1/billing/restore. Without it restore falls
# back to the local Subscription row and says so (`source:"local"`).
REVENUECAT_SECRET_KEY=
REVENUECAT_API_URL=https://api.revenuecat.com
# Optional {"<store product id>":"<PLANS key>"} when the store products are not named after PLANS.
RC_PRODUCT_MAP=

# ---- Push (Agent P). Everything is a logged no-op until PUSH_ENABLED=1. See docs/push.md. ----
PUSH_ENABLED=0
PUSH_DAILY_CAP=4           # pushes per user per local day
PUSH_QUIET_START_HOUR=23   # no push between these two local hours (wraps midnight)
PUSH_QUIET_END_HOUR=8
PUSH_MIN_GAP_MINUTES=15    # minimum gap between notification-derived pushes
PUSH_AWAY_MINUTES=30       # how long a user must be idle before a notification becomes a push
PUSH_DEFAULT_TZ=UTC        # timezone assumed for every locale except `ja` (Asia/Tokyo)

# Public origin of the web app. Referral invites and shared moments link here; without it they
# point at the placeholder host `https://rpgllm.example`.
PUBLIC_APP_URL=http://localhost:8081

# CORS allow-list (comma separated). Wildcard only while TEST_HOOKS=1.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Rate limiting (per minute). Disabled automatically while TEST_HOOKS=1; RATE_LIMIT_ENABLED=1|0 forces it.
RATE_LIMIT_ENABLED=
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_WRITE_PER_MIN=20
RATE_LIMIT_AD_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# Ops
REQUEST_LOG=1
HEALTH_DB_TIMEOUT_MS=1500
SHUTDOWN_GRACE_MS=10000

EXPO_PUBLIC_API_URL=http://localhost:4000
# Where the client builds share links (moments). Falls back to EXPO_PUBLIC_API_URL's host on web.
EXPO_PUBLIC_APP_URL=http://localhost:8081
# RevenueCat *public* SDK keys — safe in a client bundle, unlike REVENUECAT_SECRET_KEY above.
EXPO_PUBLIC_BILLING_MODE=test   # test | revenuecat
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Expo project id, needed by getExpoPushTokenAsync in a bare/EAS build.
EXPO_PUBLIC_EXPO_PROJECT_ID=
